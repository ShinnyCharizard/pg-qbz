#!/usr/bin/env python3
"""Check the packaged RPC worker using a disposable profile."""
import argparse
import json
import pathlib
import selectors
import subprocess
import tempfile

parser = argparse.ArgumentParser()
parser.add_argument('binary', type=pathlib.Path)
parser.add_argument('--fetch', action='store_true', help='Fetch public web-player app credentials; never log in')
args = parser.parse_args()

def require(condition, message):
    if not condition:
        raise RuntimeError(message)

with tempfile.TemporaryDirectory(prefix='plugin-plugin-smoke-') as profile:
    cache = pathlib.Path(profile) / 'cache'
    cache.mkdir()
    directories = {'data_dir':profile, 'cache_dir':str(cache)}
    process = subprocess.Popen([str(args.binary.resolve())], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ)
    next_id = 0
    def call(method, params):
        global next_id
        next_id += 1
        process.stdin.write(json.dumps({'jsonrpc':'2.0','id':next_id,'method':method,'params':params})+'\n')
        process.stdin.flush()
        require(bool(selector.select(60)), 'Plugin response timed out')
        response = json.loads(process.stdout.readline())
        require(response.get('id') == next_id, 'Plugin response order differs')
        require('error' not in response, 'Plugin returned an RPC error')
        return response['result']
    try:
        greeting = call('initialize', {**directories, 'locale':'es'})
        require(greeting['capabilities']['playback_events'] == 1, 'Missing event capability')
        require(not call('auth.status', {})['signed_in'], 'Unexpected session in empty profile')
        form = call('settings.open', {})
        require(all(f['control']['type'] == 'secret' for f in form['form']['fields']), 'Credentials must start masked')
        fixtures = {'app_id':'123456789', 'app_secret':'0123456789abcdef0123456789abcdef', 'private_key':'fixturekey'}
        shown = call('settings.submit', {'revision':form['revision'],'action':'visibility_1','values':fixtures})
        require(shown['form']['fields'][1]['control']['type'] == 'text', 'Eye did not reveal its field')
        form = call('settings.open', {})
        require(all(f['control']['type'] == 'secret' for f in form['form']['fields']), 'Reopened fields must be masked')
        reporting = call('reporting.status', {})
        require(reporting['queued'] == 0 and not reporting['host_supports_events'], 'Initialization created a false playback report')
        call('initialize', {**directories, 'locale':'es', 'playback_events':1})
        require(call('reporting.status', {})['host_supports_events'], 'Host capability was not negotiated')
        discarded = call('playback.event', {'kind':'started', 'playback_id':'00000000-0000-4000-8000-000000000001', 'resolution_id':'signed-out-fixture'})
        require(discarded == {'accepted':False,'discard':True}, 'Signed-out playback must be explicitly discarded')
        require(call('reporting.status', {})['queued'] == 0, 'Signed-out playback queued a provider report')
        pending = call('settings.submit', {'revision':form['revision'],'action':'sign_in','values':fixtures})
        require(bool(pending['links']), 'Missing browser authorization link')
        require(pending['values'] == {}, 'Pending authentication should not display credential fields')
        cancelled = call('settings.submit', {'revision':pending['revision'],'action':'cancel_sign_in','values':{}})
        require(not call('auth.status', {})['pending'], 'Cancellation left a login attempt running')
        print('PASS: release RPC, empty startup, masked credentials, eye toggle, browser link, cancellation, event negotiation, signed-out discard, no false reports')
        if args.fetch:
            fetched = call('settings.submit', {'revision':cancelled['revision'],'action':'fetch_credentials','values':{}})
            require(not fetched['notices'], 'Live credential discovery failed (values and response omitted)')
            require(fetched['wizard']['id'] == 'account' and not fetched['form']['fields'], 'Prepared credentials must advance to account setup')
            require(not call('auth.status', {})['signed_in'], 'Credential discovery must not sign in')
            print('PASS: live public credential discovery; all fields masked; no user login or playback')
    finally:
        process.stdin.close()
        try:
            process.wait(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()
        selector.close()
